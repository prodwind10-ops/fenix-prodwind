# Gradle caches and local config
.gradle/
local.properties

# Build output. Mozilla's conventions plugin redirects every project's build directory into
# .topobjdir/gradle/build/..., so the APK ends up there. The Gradle problems/configuration-cache
# reports are still written under the root project's build/ directory.
.topobjdir/
/mobile/android/fenix/build/
*.apk

