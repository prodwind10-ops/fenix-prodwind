<!-- The texts of the backup and restore feature (package org.mozilla.fenix.backup). They are in a file of their own, so
     that the strings the app gets from Mozilla stay untouched. -->
<resources>
    <!-- Settings -->
    <string name="pref_key_backup_restore" translatable="false">pref_key_backup_restore</string>
    <string name="backup_settings_title">Backup and restore</string>

    <!-- The screen -->
    <string name="backup_title">Backup and restore</string>
    <string name="backup_back">Back</string>
    <string name="backup_intro">Save all the data of this app to one file, and restore it from that file later: after an app update that had to be uninstalled first, or on another phone.</string>
    <string name="backup_create_button">Create a backup file</string>
    <string name="backup_restore_button">Restore from a backup file</string>
    <string name="backup_restore_hint">Restoring adds what is in the file to what is in the app. Nothing that is in the app is deleted or replaced, except settings, which are taken from the file.</string>
    <string name="backup_not_included">Not included: the Firefox account (sign in again to get your synced data), add-ons, site permissions, downloads, credit cards and addresses, private tabs, and the data that websites store themselves (except cookies).</string>
    <string name="backup_progress_working">Working…</string>
    <string name="backup_progress_saving">Saving: %1$s</string>
    <string name="backup_progress_restoring">Restoring: %1$s</string>
    <string name="backup_unknown">unknown</string>
    <string name="backup_cancel">Cancel</string>
    <string name="backup_close">Close</string>

    <!-- Making a backup -->
    <string name="backup_create_title">Create a backup</string>
    <string name="backup_create_choose">Choose what to save:</string>
    <string name="backup_create_continue">Choose where to save</string>
    <string name="backup_sensitive_label">%1$s (sensitive)</string>
    <string name="backup_passphrase_explanation">Protect the file with a passphrase. You will need it to restore the backup, and it cannot be recovered if you forget it. Leave it empty to save the file without protection.</string>
    <string name="backup_passphrase_hint">Passphrase</string>
    <string name="backup_passphrase_repeat_hint">Repeat the passphrase</string>
    <string name="backup_error_nothing_selected">Choose at least one thing.</string>
    <string name="backup_error_passphrase_mismatch">The two passphrases are not the same.</string>
    <string name="backup_error_passphrase_short">Use at least 8 characters, or leave the passphrase empty.</string>
    <string name="backup_unprotected_title">Save without protection?</string>
    <string name="backup_unprotected_message">The passwords and cookies in this backup would be saved as readable text. Anyone who gets the file can use them.</string>
    <string name="backup_unprotected_confirm">Save without protection</string>
    <string name="backup_error_lost_choices">Your choices were lost while you chose the file. Please start again.</string>

    <!-- Restoring a backup -->
    <string name="backup_passphrase_title">Passphrase</string>
    <string name="backup_passphrase_prompt">This backup is protected. Enter its passphrase.</string>
    <string name="backup_passphrase_wrong">The passphrase is wrong, or the file is damaged. Try again.</string>
    <string name="backup_passphrase_open">Open</string>
